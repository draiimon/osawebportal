API_PORT=8787
CORS_ORIGIN=*

# Behind a reverse proxy (Render, nginx, Cloudflare), set the number of trusted
# proxy hops so rate limiting keys on the real client IP. Leave unset for local.
# TRUST_PROXY=1

# Chat OTP: restrict to campus student mail (matches window.__OSA_ALLOWED_EMAIL_DOMAIN__ on pages)
# Example EAC Cavite student mail host — set from your registrar/IT policy
OSA_ALLOWED_EMAIL_DOMAIN=student.cvt.eac.edu.ph

# ── Database ─────────────────────────────────────────────────────
# Option A: Full URL (preferred when available)
# DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/admin

# Option B: Split params
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=admin
DB_USER=postgres
DB_PASSWORD=change_me
# Set true only when your DB requires SSL (Supabase, RDS, etc.)
DB_SSL=false

# ── LLM providers (Tier 2 chat) ──────────────────────────────────
CHAT_PRIMARY_PROVIDER=gemini
CHAT_FALLBACK_PROVIDER=groq
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openai/gpt-oss-20b:free
HUGGINGFACE_API_KEY=your_huggingface_api_key
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.2
# Optional tuning
CHAT_MAX_OUTPUT_TOKENS=220
CHAT_TIER1_MAX_OUTPUT_TOKENS=170
CHAT_TEMPERATURE=0.4
# Default FALSE: Tier-1 returns curated FAQ answers directly (fast, deterministic).
# Set TRUE to have the LLM rewrite FAQ answers naturally (adds 300–800 ms).
CHAT_TIER1_REWRITE=false
# Idle timeout for a chat session (defaults to 30 min of inactivity)
CHAT_SESSION_TTL_MS=1800000
CHAT_HUMAN_WAIT_NOTIFY_MS=300000
STAFF_CHAT_IDLE_TIMEOUT_MS=1800000

# ── Chatbot v2 pipeline (same DB, no external DB needed) ──────────
CHATBOT_MEMORY_ENABLED=true
CHATBOT_MEMORY_TURNS=10
CHATBOT_CACHE_TTL_SECONDS=21600
CHATBOT_MAX_OUTPUT_TOKENS=280
CHATBOT_TEMPERATURE=0.3

# ── OTP security ─────────────────────────────────────────────────
# Required: HMAC pepper for hashing OTP codes at rest.
OTP_PEPPER=change_me_to_a_long_random_string

# ── Brevo (OTP + ticket emails) ──────────────────────────────────
Brevo_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=no-reply@your-domain.example
BREVO_SENDER_NAME=OSA System

# ── Staff + portal links (used in ticket emails) ─────────────────
OSA_STAFF_EMAIL=osa-staff@your-domain.example
PORTAL_URL=http://localhost:8787

# ── Admin auth (x-admin-key header on admin routes) ──────────────
# If unset, admin routes are open and the server logs a warning at startup.
ADMIN_KEY=change_me_to_a_long_random_string

# ── JWT auth (React/API migration layer) ──────────────────────────
JWT_SECRET=change_me_to_a_long_random_jwt_secret
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10
