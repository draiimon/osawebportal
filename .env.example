API_PORT=8787
CORS_ORIGIN=*
DISABLE_RATE_LIMITS_LOCAL=true
# DISABLE_RATE_LIMITS=true

# Behind a reverse proxy (Render, nginx, Cloudflare), set the number of trusted
# proxy hops so rate limiting keys on the real client IP. Leave unset for local.
# TRUST_PROXY=1

# Chat OTP: restrict to campus student mail (matches window.__OSA_ALLOWED_EMAIL_DOMAIN__ on pages)
# Example EAC Cavite student mail host — set from your registrar/IT policy
OSA_ALLOWED_EMAIL_DOMAIN=student.cvt.eac.edu.ph

# ── Database ─────────────────────────────────────────────────────
# Option A: Full URL (preferred when available)
# DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/admin

# Option B: Split params
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=admin
DB_USER=postgres
DB_PASSWORD=change_me
# Set true only when your DB requires SSL (Supabase, RDS, etc.)
DB_SSL=false

# ── LLM providers (Tier 2 chat) ──────────────────────────────────
CHAT_PRIMARY_PROVIDER=gemini
CHAT_FALLBACK_PROVIDER=groq
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
# Free-tier Gemini fallback chain tried in order when primary model returns 503 "high demand".
# Defaults: gemini-2.5-flash-8b (lighter), gemini-2.0-flash-lite (most stable free allocation).
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash-8b,gemini-2.0-flash-lite
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openai/gpt-oss-20b:free
HUGGINGFACE_API_KEY=your_huggingface_api_key
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.2
# Optional tuning
# Room for long KB answers (Vision/Mission, policies). Lower to save tokens/latency if needed.
CHAT_MAX_OUTPUT_TOKENS=1024
CHAT_TIER1_MAX_OUTPUT_TOKENS=400
CHAT_TEMPERATURE=0.4
# Lower temperature when no RAG chunks matched (reduces invented policies); capped by CHAT_TEMPERATURE.
CHAT_TEMPERATURE_NO_KB=0.12
# Default true: do not call Tier-2 LLM when rag_chunks returned 0 rows unless the message is a greeting, escalation, appointment, live listing, or (with live DB context) hours/location/contact.
CHAT_STRICT_NO_RAG_LLM=true
# Default FALSE: Tier-1 returns curated FAQ answers directly (fast, deterministic).
# Set TRUE to have the LLM rewrite FAQ answers naturally (adds 300–800 ms).
CHAT_TIER1_REWRITE=false
# When TRUE, secure /chat/message checks curated FAQ first (Tier 1 instant match).
# Default FALSE so students get Tier 2 (LLM + RAG + live portal DB) for a more natural assistant; enable for strict FAQ-first ops.
CHAT_TIER1_FAQ_ENABLED=false
# Guest widget FAQ tier — OFF by default so AI is always primary. Only enable as last resort (e.g., all Gemini keys dead).
# CHATBOT_TIER1_FAQ_ENABLED=false
# Minimum RAG confidence (0–1) before Tier-2 may answer from retrieved chunks; below → standardized escalation message (no LLM). Guest /chatbot uses the same default via CHATBOT_RAG_MIN_CONFIDENCE.
CHAT_RAG_MIN_CONFIDENCE=0.58
# Optional override for guest widget only (defaults to CHAT_RAG_MIN_CONFIDENCE).
# CHATBOT_RAG_MIN_CONFIDENCE=0.52
# Idle timeout for a chat session (defaults to 30 min of inactivity)
CHAT_SESSION_TTL_MS=1800000
CHAT_HUMAN_WAIT_NOTIFY_MS=300000
STAFF_CHAT_IDLE_TIMEOUT_MS=1800000
# Testing only: allow creating a new appointment ticket even if an older
# appointment ticket in the same session is still open/in-progress.
ALLOW_REPEAT_APPOINTMENT_TEST=false

# ── Chatbot v2 pipeline (same DB, no external DB needed) ──────────
CHATBOT_MEMORY_ENABLED=true
CHATBOT_MEMORY_TURNS=10
CHATBOT_CACHE_TTL_SECONDS=21600
CHATBOT_MAX_OUTPUT_TOKENS=1024
CHATBOT_TEMPERATURE=0.3
# Guest widget: default false (Groq/smartRouter first) to avoid Gemini free-tier 429s. Set true to try Gemini first when RAG has chunks.
# CHATBOT_GEMINI_FIRST_WITH_RAG=true

# ── RAG (Tier 2 TRUE semantic retrieval over rag_chunks) ─────────
# Gemini embedding model. gemini-embedding-001 supports variable dims via outputDimensionality.
# Keep GEMINI_EMBED_DIMENSIONS=768 to match vector(768) in rag_chunks table.
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIMENSIONS=768
# Embedding provider: auto (Gemini first; see Render geo note) | gemini | openai
# Google AI Studio often blocks datacenter IPs ("User location is not supported"). On Render,
# set OPENAI_API_KEY and keep fallback on, or use openai-only after re-embedding all chunks.
# EMBED_PROVIDER=auto
# OPENAI_API_KEY=
# OPENAI_EMBED_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=https://api.openai.com/v1/embeddings
# EMBED_OPENAI_FALLBACK=true
RAG_TOP_K=5
# Retrieval floor — chunks below this similarity are excluded.
RAG_THRESHOLD=0.55
# Quality gate — if the TOP chunk is below this, treat as low-confidence
# ("insufficient data"). User-facing fallback rules live in server/chat.js.
RAG_QUALITY_GATE=0.70
RAG_MAX_CONTEXT_TOKENS=1500
# Keyword overlap: boosts confidence + merges chunks whose keywords matched but vector search missed.
# Set false for pure-vector only.
RAG_KEYWORD_AUGMENT=true
# Synthetic similarity for keyword-rescue rows (must stay >= RAG_THRESHOLD). Default 0.62.
# RAG_KEYWORD_RESCUE_SIMILARITY=0.62
# In-memory LRU cache (survives per-process; Redis can replace later).
RAG_CACHE_MAX=500
RAG_CACHE_TTL_MS=600000
# Set RAG_DEBUG=true to log retrieval pipeline (keywords, top chunks, scores).
RAG_DEBUG=false

# ── OTP security ─────────────────────────────────────────────────
# Required: HMAC pepper for hashing OTP codes at rest.
OTP_PEPPER=change_me_to_a_long_random_string
# Temporary local testing mode: no OTP emails are sent.
# When true, /otp/send skips provider calls and /otp/verify accepts OTP_TEST_CODE.
OTP_TEST_MODE=false
OTP_TEST_CODE=00000
# Optional: comma-separated emails that bypass OTP send/verify rate limits for local testing
OTP_TEST_BYPASS_EMAILS=

# ── Brevo (OTP + ticket emails) ──────────────────────────────────
Brevo_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=no-reply@your-domain.example
BREVO_SENDER_NAME=OSA System

# ── Staff + portal links (used in ticket emails) ─────────────────
OSA_STAFF_EMAIL=osa-staff@your-domain.example
PORTAL_URL=http://localhost:8787

# ── Admin auth (x-admin-key header on admin routes) ──────────────
# If unset, admin routes are open and the server logs a warning at startup.
ADMIN_KEY=change_me_to_a_long_random_string

# ── JWT auth (React/API migration layer) ──────────────────────────
JWT_SECRET=change_me_to_a_long_random_jwt_secret
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10
