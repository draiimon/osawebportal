# Copy these NAMES into Render → Environment (paste values there only).
# Gemini / Google AI Studio keys only — no Groq/OpenAI here.
# DO NOT commit real keys to git.
#
# Render injects PORT automatically — do not set PORT manually.
# DATABASE_URL + DB_SSL=true (Supabase pooler) must match production DB.
# CORS_ORIGIN=https://your-frontend-domain  (or * while testing)
#
# If the React app is hosted separately (not same domain as API), build the
# frontend with absolute API URLs, e.g.:
#   VITE_API_BASE_URL=https://YOUR-SERVICE.onrender.com/api/v1
#   VITE_SOCKET_BASE_URL=https://YOUR-SERVICE.onrender.com/ws/chat
#   VITE_LEGACY_BASE_URL=https://YOUR-SERVICE.onrender.com

GEMINI_API_KEY=
GEMINI_API_KEY2=
GEMINI_API_KEY3=
GEMINI_API_KEY4=
GEMINI_API_KEY5=
GEMINI_API_KEY6=
GEMINI_API_KEY7=
GEMINI_API_KEY8=
GEMINI_API_KEY9=
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIMENSIONS=768
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_API_KEY_10=
GOOGLE_API_KEY_11=
# If Gemini embed returns FAILED_PRECONDITION / "User location is not supported" on Render:
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
EMBED_OPENAI_FALLBACK=true
# After switching embedding model, run admin re-embed so all chunks share one vector space.
# EMBED_PROVIDER=openai
